pipeline {



    agent any



    stages {



        stage('Checkout Code') {

            steps {

                checkout scm

            }

        }



        stage('Install Dependencies') {

            steps {

                sh 'npm install'

            }

        }



        stage('Run Tests') {

            steps {

                sh 'npm test'

            }

        }



        stage('Build Docker Image') {

            steps {

                sh 'docker build -t jenkins-cicd-demo .'

            }

        }



        stage('Deploy Application') {

            steps {

                sh '''

                docker rm -f node-app || true



                docker run -d \

                --name node-app \

                -p 3000:3000 \

                jenkins-cicd-demo

                '''

            }

        }

    }



    post {



        success {

            echo "Deployment Successful"

        }



        failure {

            echo "Deployment Failed"

        }

    }

}

